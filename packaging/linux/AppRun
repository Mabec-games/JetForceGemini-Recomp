#!/bin/bash
# AppImage entry point. The image holds this repository's source and no game
# data. On first launch it builds the game locally from the user's own ROM and
# caches the result; later launches just start the game.
set -u

HERE="$(dirname "$(readlink -f "$0")")"
SOURCE_IMAGE="$HERE/usr/share/jfg-recomp/src"
SOURCE_ID="$(cat "$HERE/usr/share/jfg-recomp/source-id" 2>/dev/null || echo unknown)"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/JFGRecomp"
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}/jfg/appimage"
WORK="$CACHE_HOME/$SOURCE_ID"
SOURCE="$WORK/src"
PROFILE="$DATA_HOME/profiles/default"
ROM="$DATA_HOME/roms/jfg.us.z64"
EXE_RECORD="$WORK/executable.path"
ROM_SHA1="493ced9008dbe932d6e91179b68e8630cf23a023"
LAUNCHER="$HERE/usr/bin/jfg-launcher"
LAUNCHER_BACKGROUND="$HERE/usr/share/jfg-recomp/launcher/background.jpg"
# Present only in the offline edition (scripts/make_offline_bundle.py).
OFFLINE="$HERE/usr/share/jfg-recomp/offline"

usage() {
  cat <<USAGE
Mabecs Jet Force Gemini Recomp (Linux)

  JFG.AppImage                 start the game (first run builds it from your ROM)
  JFG.AppImage --rom FILE      import FILE (US .z64) and build, then play
  JFG.AppImage --rebuild       discard this version's build and build again
  JFG.AppImage --build-only    build without starting the game
  JFG.AppImage --version       print the source revision

Saves and the imported ROM: $DATA_HOME
Build cache (safe to delete): $CACHE_HOME
USAGE
}

say() { printf '%s\n' "$*" >&2; }

ask_rom() {
  if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    zenity --file-selection --title="Select your Jet Force Gemini (US) .z64 ROM" \
      --file-filter="N64 ROM | *.z64" 2>/dev/null && return
  fi
  if [ -t 0 ]; then
    read -r -p "Path to your Jet Force Gemini (US) .z64 ROM: " path && printf '%s\n' "$path" && return
  fi
  return 1
}

import_rom() {
  local candidate="$1"
  if [ ! -f "$candidate" ] || [ "$(stat -c %s "$candidate")" != 33554432 ]; then
    say "That is not the supported 32 MiB US big-endian .z64 ROM."; return 1
  fi
  if [ "$(sha1sum "$candidate" | cut -d' ' -f1)" != "$ROM_SHA1" ]; then
    say "ROM checksum does not match the supported US revision (other regions, hacks and byte-swapped dumps are not supported)."
    return 1
  fi
  mkdir -p "$(dirname "$ROM")" && cp -f -- "$candidate" "$ROM.tmp" && mv -f -- "$ROM.tmp" "$ROM"
}

preflight() {
  local missing=() tool
  # samurai (Arch's "samu") is a drop-in ninja; CMake only needs a `ninja` executable.
  if ! command -v ninja >/dev/null 2>&1 && command -v samu >/dev/null 2>&1; then
    SHIM="$(mktemp -d)" && ln -s "$(command -v samu)" "$SHIM/ninja" && PATH="$SHIM:$PATH"
    export PATH
  fi
  for tool in git cmake ninja gcc g++ make python3 readelf mips-linux-gnu-as mips-linux-gnu-objcopy timeout; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if [ -d "$OFFLINE/deps" ] && ! command -v curl >/dev/null 2>&1 && ! command -v wget >/dev/null 2>&1; then
    missing+=("curl (or wget)")
  fi
  local libs_missing=()
  for lib in libSDL2-2.0.so.0 libvulkan.so.1 libX11.so.6; do
    ldconfig -p 2>/dev/null | grep -q "$lib" || libs_missing+=("$lib")
  done
  python3 -c 'import venv, sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null \
    || missing+=("python3 >= 3.11 with venv")
  if [ ${#missing[@]} -ne 0 ] || [ ${#libs_missing[@]} -ne 0 ]; then
    say "The first-run build needs tools that are not installed:"
    [ ${#missing[@]} -ne 0 ] && say "  missing tools: ${missing[*]}"
    [ ${#libs_missing[@]} -ne 0 ] && say "  missing libraries: ${libs_missing[*]}"
    say ""
    say "On Debian/Ubuntu:"
    say "  sudo apt install build-essential gcc-multilib binutils-mips-linux-gnu python3-venv python3-pip pkg-config cmake ninja-build git wget libsdl2-dev libx11-dev libxrandr-dev libvulkan-dev libasound2-dev"
    say "On Arch / CachyOS / Manjaro (enable the multilib repo for the lib32 packages):"
    say "  sudo pacman -S --needed base-devel git cmake ninja python python-pip pkgconf wget sdl2 libx11 libxrandr vulkan-icd-loader vulkan-headers alsa-lib lib32-glibc lib32-gcc-libs"
    say "  mips-linux-gnu-as is not in the official repos; install it from the AUR:"
    say "  paru -S mips-linux-gnu-binutils      (or: yay -S mips-linux-gnu-binutils)"
    say "  ('ninja' must be the real package named ninja; the 'samurai' package also works.)"
    say "Other distributions: install the equivalents, then run this again."
    return 1
  fi
}

git_config_count=0
add_git_config() {
  export "GIT_CONFIG_KEY_$git_config_count=$1" "GIT_CONFIG_VALUE_$git_config_count=$2"
  git_config_count=$((git_config_count + 1))
  export GIT_CONFIG_COUNT=$git_config_count
}

download() { # URL FILE
  # Some home routers never answer IPv6 (AAAA) lookups, so a normal attempt
  # waits for the full timeout. Try IPv4 first; fall back to the default
  # (which includes IPv6) for IPv6-only connections.
  if command -v curl >/dev/null 2>&1; then
    curl -4 -fsSL --connect-timeout 20 --speed-limit 1024 --speed-time 30 -o "$2" "$1" \
      || curl -fsSL --connect-timeout 20 --speed-limit 1024 --speed-time 30 -o "$2" "$1"
  else
    wget -4 -q --timeout=30 -O "$2" "$1" || wget -q --timeout=30 -O "$2" "$1"
  fi
}

# Offline edition: the open-source dependencies ship inside the AppImage.
# Restore them into the build cache, then point git and pip at the local
# copies so that the build downloads nothing except IDO, the original N64
# compiler, which is proprietary and therefore never bundled.
prepare_offline() {
  [ -d "$OFFLINE/deps" ] || return 0
  local key deps marker tools repo url path ido_dir ido_url ido_sha tarball attempt python_version
  key="$(python3 -c 'import hashlib, sys; from pathlib import Path
print(hashlib.sha256(str(Path(sys.argv[1]).resolve()).encode()).hexdigest()[:12])' "$SOURCE")" || return 1
  deps="$WORK/b/$key/d"   # Where build_from_rom.py looks for its dependencies.
  tools="$deps/Jet-Force-Gemini/tools"
  marker="$deps/.offline-$SOURCE_ID"
  add_git_config protocol.file.allow always
  add_git_config uploadpack.allowAnySHA1InWant true
  while IFS=$'\t' read -r url path; do
    [ -n "$url" ] && add_git_config "url.$deps/$path.insteadOf" "$url"
  done < "$OFFLINE/git-redirects.tsv"

  if [ ! -f "$marker" ]; then
    echo "unpack-offline"; echo "JFG-SUPPORT setup_step=unpack-offline"
    rm -rf "$deps" && mkdir -p "$deps" && cp -a "$OFFLINE/deps/." "$deps/" || return 1
    for repo in "$deps"/*/; do
      git -C "$repo" reset -q --hard && git -C "$repo" submodule --quiet update --init --recursive --force \
        || { say "Unpacking the bundled dependencies failed in $repo"; return 1; }
    done
    mkdir -p "$tools/objdiff" && cp "$OFFLINE/objdiff/objdiff-cli" "$tools/objdiff/" || return 1
    gcc -I "$tools" -Wall -O2 -s -std=c99 -o "$tools/n64crc" "$tools/n64crc.c" -lm \
      || { say "Building n64crc failed"; return 1; }
    touch "$marker"
  fi

  ido_dir="$tools/ido-recomp/linux"
  if [ ! -x "$ido_dir/cc" ]; then
    echo "download-ido"; echo "JFG-SUPPORT setup_step=download-ido"
    read -r ido_url ido_sha < <(python3 -c 'import json, sys; d = json.load(open(sys.argv[1]))
print(d["url"], d["sha256"])' "$OFFLINE/ido.json") || return 1
    tarball="$WORK/ido.tar.gz"
    for attempt in 1 2 3 4 5; do
      if download "$ido_url" "$tarball" && [ "$(sha256sum "$tarball" | cut -d' ' -f1)" = "$ido_sha" ]; then
        break
      fi
      rm -f "$tarball"
      say "Downloading IDO did not work (attempt $attempt of 5)."
      [ "$attempt" = 5 ] || sleep 5
    done
    if [ ! -f "$tarball" ]; then
      say "IDO download failed: the 4.8 MB IDO compiler could not be downloaded from $ido_url. Check your internet connection and try again."
      return 1
    fi
    # Extract next to the target and move it into place only when complete, so
    # an interrupted run never leaves a partial compiler that looks installed.
    rm -rf "$ido_dir.partial" && mkdir -p "$ido_dir.partial" \
      && tar --no-same-owner -xzf "$tarball" -C "$ido_dir.partial" \
      && rm -rf "$ido_dir" && mv "$ido_dir.partial" "$ido_dir" && rm -f "$tarball" \
      || { say "Unpacking IDO failed"; return 1; }
  fi

  # Python packages come from the bundled wheels. For a Python version they
  # were not prepared for, still prefer them but allow the package index.
  export PIP_FIND_LINKS="$OFFLINE/wheels" PIP_DISABLE_PIP_VERSION_CHECK=1
  python_version="$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
  if python3 -c 'import json, sys; sys.exit(sys.argv[2] not in json.load(open(sys.argv[1]))["pythons"])' \
       "$OFFLINE/manifest.json" "$python_version"; then
    export PIP_NO_INDEX=1
  fi
}

build() {
  preflight || return 1
  if [ ! -f "$ROM" ]; then say "No ROM imported yet."; return 1; fi
  mkdir -p "$WORK"
  if [ ! -f "$SOURCE/.complete" ]; then
    rm -rf "$SOURCE"
    mkdir -p "$SOURCE" && cp -a "$SOURCE_IMAGE/." "$SOURCE/" && touch "$SOURCE/.complete" || return 1
  fi
  local log="$WORK/build.log" executable
  if [ -d "$OFFLINE/deps" ]; then
    say "Building the game from your ROM. Everything needed is included except one 4.8 MB download; this takes a while and only happens once."
  else
    say "Building the game from your ROM. This downloads dependencies and takes a while; it only happens once."
  fi
  # Git waits forever on a stalled HTTPS download. Give up after 60 seconds
  # below 1 KiB/s so the user sees an error and can retry instead of a hang.
  export GIT_HTTP_LOW_SPEED_LIMIT="${GIT_HTTP_LOW_SPEED_LIMIT:-1024}"
  export GIT_HTTP_LOW_SPEED_TIME="${GIT_HTTP_LOW_SPEED_TIME:-60}"
  # Not in a pipeline: prepare_offline exports the git and pip settings.
  prepare_offline > >(tee "$log") 2>&1 || { say "Build failed. Full output: $log"; return 1; }
  if ! env -u LD_LIBRARY_PATH python3 "$SOURCE/scripts/build_from_rom.py" --rom "$ROM" \
        --build-root "$WORK/b" 2>&1 | tee -a "$log"; then
    say "Build failed. Full output: $log"; return 1
  fi
  executable="$(sed -n 's/^Built: //p' "$log" | tail -n 1)"
  if [ -z "$executable" ] || [ ! -x "$executable" ]; then say "Build did not produce an executable. See $log"; return 1; fi
  printf '%s\n' "$executable" > "$EXE_RECORD"
}

play() {
  local executable
  executable="$(cat "$EXE_RECORD")"
  mkdir -p "$PROFILE"
  # Drop any inherited JFG_* diagnostics so only the intended profile is used.
  while IFS='=' read -r name _; do case "$name" in JFG_*) unset "$name";; esac; done < <(env)
  exec "$executable" --rom "$ROM" --save "$PROFILE/jfg.flash" \
    --controller-pak "$PROFILE/controller-1.pak" --play
}

# The first-run window: only while the game still needs to be built, only with
# a desktop session, and only if the window can actually open on this system.
# Otherwise the zenity/terminal flow below is used as before.
launcher_available() {
  [ "${JFG_LAUNCHER_CHILD:-}" != 1 ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && [ -x "$LAUNCHER" ] \
    && "$LAUNCHER" --probe >/dev/null 2>&1
}

needs_build() {
  [ ! -f "$ROM" ] || [ ! -f "$EXE_RECORD" ] || [ ! -x "$(cat "$EXE_RECORD")" ]
}

rom_arg=""; rebuild=0; build_only=0; check_tools=0
while [ $# -gt 0 ]; do
  case "$1" in
    --rom) shift; rom_arg="${1:-}";;
    --rebuild) rebuild=1;;
    --build-only) build_only=1;;
    --check-tools) check_tools=1;;
    --version) echo "$SOURCE_ID"; exit 0;;
    -h|--help) usage; exit 0;;
    *) usage >&2; exit 64;;
  esac
  shift
done

if [ "$check_tools" = 1 ]; then preflight 2>&1; exit $?; fi

[ "$rebuild" = 1 ] && rm -rf "$WORK"

if [ -z "$rom_arg" ] && needs_build && launcher_available; then
  # The window imports the ROM and runs "AppRun --build-only"; exit 0 means ready.
  launcher_options=()
  [ -d "$OFFLINE/deps" ] && launcher_options+=(--offline)
  "$LAUNCHER" --apprun "$HERE/AppRun" --rom-store "$ROM" --rom-sha1 "$ROM_SHA1" \
    --background "$LAUNCHER_BACKGROUND" --icon "$HERE/jfg-recomp.png" --build-log "$WORK/build.log" \
    "${launcher_options[@]}" || exit 1
  [ "$build_only" = 1 ] && exit 0
  play
fi

if [ -n "$rom_arg" ]; then
  import_rom "$rom_arg" || exit 2
elif [ ! -f "$ROM" ]; then
  chosen="$(ask_rom)" || { say "No ROM selected. Run again with --rom FILE."; exit 2; }
  import_rom "$chosen" || exit 2
fi

if [ ! -f "$EXE_RECORD" ] || [ ! -x "$(cat "$EXE_RECORD")" ]; then
  build || exit 1
fi
[ "$build_only" = 1 ] && { say "Build complete."; exit 0; }
play
